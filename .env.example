# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:7392
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=info

# =============================================================================
# AI — OpenRouter (chat, all LLM calls)
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENROUTER_REFERER=https://your-domain.com
# OPENROUTER_TITLE=Your App Name

# AI — Google Gemini (embeddings only)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-gemini-api-key-here
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# AI — Cohere (reranker only)
COHERE_API_KEY=your-cohere-api-key-here

# =============================================================================
# AUTH (NextAuth v5)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-32-character-secret-key-here
NEXTAUTH_URL=http://localhost:7392
AUTH_GITHUB_ID=your-github-oauth-app-id
AUTH_GITHUB_SECRET=your-github-oauth-app-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# =============================================================================
# DATABASE (single direct connection URL — Postgres with pgvector)
# =============================================================================
DATABASE_URL="postgresql://user:password@your-host/dbname?sslmode=require"

# =============================================================================
# STORAGE (Cloudinary)
# =============================================================================
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# =============================================================================
# REDIS (Upstash)
# =============================================================================
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================================================
# BACKGROUND JOBS (Inngest)
# =============================================================================
INNGEST_SIGNING_KEY=dev-signing-key-change-in-production
INNGEST_EVENT_KEY=dev-event-key-change-in-production

# =============================================================================
# REALTIME (Ably)
# =============================================================================
ABLY_API_KEY=your-ably-api-key

# PostHog (optional product analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set to true to run without GitHub/Google OAuth in production
# AUTH_CREDENTIALS_ONLY=true

# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=change-this-to-a-32-character-key-for-production
# Generate with: openssl rand -base64 32
CSRF_SECRET=generate-a-random-csrf-secret-for-production
ALLOWED_ORIGINS=http://localhost:7392
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-a-random-secret-for-cron-jobs
# Generate with: openssl rand -hex 16
INTERNAL_API_KEY=rsk_dev_your-internal-api-key
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=generate-a-random-internal-secret
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=whsec_generate-a-webhook-secret
# Generate with: openssl rand -base64 48
DEPLOY_WEBHOOK_SECRET=generate-a-deploy-webhook-secret

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_TO_EMAIL="your-email@example.com"
RESEND_WEBHOOK_SECRET="whsec_your-webhook-secret"

# =============================================================================
# VECTOR SEARCH (pgvector — included with PostgreSQL)
# =============================================================================
# Text embeddings: vector(768). Image embeddings: vector(512).
# No separate vector database is required. EMBEDDING_DIMENSIONS must match.

# =============================================================================
# RERANKER (Cohere)
# =============================================================================
RERANKER_ENABLED=true
RERANKER_PROVIDER=cohere

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
# Comma-separated additional domains for CSP connect-src (optional)
# CSP_CONNECT_SRC=
# CSP_REPORT_ENDPOINT=https://your-endpoint.example.com/csp-report

# =============================================================================
# OBSERVABILITY (Optional — uncomment to enable)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# OTEL_SERVICE_NAME=rag-starter-kit
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example.com:4318
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your-key

# =============================================================================
# SEO & ANALYTICS (Optional — uncomment to enable)
# =============================================================================
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# NEXT_PUBLIC_ANALYTICS_HOST=https://plausible.io
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# =============================================================================
# INTEGRATIONS (Optional — uncomment and configure as needed)
# =============================================================================
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret
# SLACK_SIGNING_SECRET=your-slack-signing-secret
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# NOTION_CLIENT_ID=your-notion-client-id
# NOTION_CLIENT_SECRET=your-notion-client-secret
# NOTION_API_KEY=secret_xxx
# GITHUB_TOKEN=ghp_xxx
# YOUTUBE_API_KEY=your-youtube-api-key
# TAVILY_API_KEY=tvly-xxx

# =============================================================================
# ALTERNATIVE AI PROVIDERS (Optional — uncomment to enable)
# =============================================================================
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3

# =============================================================================
# ENCRYPTION KMS (Optional — uncomment to use cloud KMS instead of local key)
# =============================================================================
# KMS_PROVIDER=aws
# AWS_KMS_KEY_ID=alias/your-kms-key
# AWS_REGION=us-east-1
# KMS_PROVIDER=azure
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# AZURE_KEY_NAME=your-key-name
# KMS_PROVIDER=gcp
# GCP_KMS_KEY_NAME=projects/your-project/locations/global/keyRings/your-ring/cryptoKeys/your-key
